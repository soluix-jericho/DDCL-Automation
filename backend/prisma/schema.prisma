generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StepKind {
  forward
  rollback
}

enum DdclStatus {
  Draft
  SudahDikirim @map("Sudah Dikirim")
}

model Step {
  id                   String          @id @default(cuid())
  name                 String
  category             String
  kind                 StepKind        @default(forward)
  pairedRollbackStepId String?
  pairedRollbackStep   Step?           @relation("StepRollbackPair", fields: [pairedRollbackStepId], references: [id])
  pairedForwardSteps   Step[]          @relation("StepRollbackPair")
  checklistItems       ChecklistItem[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  columns              StepColumn[]
  attachments          StepAttachment[]
  forwardMemberships   BundleForwardMember[]
  rollbackMemberships  BundleRollbackMember[]

  @@index([pairedRollbackStepId])
}

// The case-insensitive unique indexes step_name_unique and bundle_name_unique
// (lower(btrim(name)), ...) exist only in the SQL migration: Prisma cannot express them.
model StepColumn {
  id       String     @id @default(cuid())
  stepId   String
  step     Step       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  position Int
  label    String?
  lines    StepLine[]

  @@unique([stepId, position])
}

model StepLine {
  id       String     @id @default(cuid())
  columnId String
  column   StepColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  position Int
  text     String     @db.Text

  @@unique([columnId, position])
}

model StepAttachment {
  id       String @id @default(cuid())
  stepId   String
  step     Step   @relation(fields: [stepId], references: [id], onDelete: Cascade)
  filename String
  content  String @db.Text
  position Int

  @@unique([stepId, filename])
}

model StepBundle {
  id              String                 @id @default(cuid())
  name            String
  category        String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  forwardMembers  BundleForwardMember[]
  rollbackMembers BundleRollbackMember[]
}

model BundleForwardMember {
  bundleId String
  bundle   StepBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  stepId   String
  step     Step       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  position Int

  @@id([bundleId, stepId])
  @@unique([bundleId, position])
  @@index([stepId])
}

model BundleRollbackMember {
  bundleId String
  bundle   StepBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  stepId   String
  step     Step       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  position Int

  @@id([bundleId, stepId])
  @@unique([bundleId, position])
  @@index([stepId])
}

enum UserRole {
  admin
  editor
  viewer
}

enum UserStatus {
  active
  inactive
}

enum AuditEventType {
  login_success
  login_failed
  login_locked
  logout
  account_created
  role_changed
  account_deactivated
  account_reactivated
  password_changed
  password_reset_by_admin
  lockout_cleared_by_admin
}

model User {
  id           String       @id @default(cuid())
  name         String
  // Stored trimmed and lowercase by the code (BR4.1).
  email        String       @unique
  passwordHash String
  role         UserRole
  status       UserStatus   @default(active)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lastLoginAt  DateTime?
  sessions     Session[]
  ddcls        DdclDocument[] @relation("DdclCreator")
  auditActor   AuditEvent[] @relation("AuditActor")
  auditTarget  AuditEvent[] @relation("AuditTarget")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

model LoginThrottle {
  email       String    @id
  failedCount Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @default(now()) @updatedAt
}

model AuditEvent {
  id           String         @id @default(cuid())
  occurredAt   DateTime       @default(now())
  type         AuditEventType
  actorUserId  String?
  actor        User?          @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  targetUserId String?
  target       User?          @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  email        String?
  ipAddress    String?
  detail       String?        @db.VarChar(500)

  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@index([type, occurredAt(sort: Desc), id(sort: Desc)])
}

model DdclDocument {
  id             String          @id @default(cuid())
  title          String
  status         DdclStatus      @default(Draft)
  // Nullable in the database, enforced by the application and checked at every start (BR4.16).
  createdByUserId String?
  createdBy       User?          @relation("DdclCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime        @default(now())
  releaseHeader  ReleaseHeader?
  checklistItems ChecklistItem[]
}

model ReleaseHeader {
  id               String       @id @default(cuid())
  ddclId           String       @unique
  ddcl             DdclDocument @relation(fields: [ddclId], references: [id])
  date             DateTime?    @db.Date
  startDate        DateTime?    @db.Date
  impactedSystem   String?
  environment      String?
  phaseRelease     String?
  releaseObjective String?
  technicalChange  String?
}

model ChecklistItem {
  id              String       @id @default(cuid())
  ddclId          String
  ddcl            DdclDocument @relation(fields: [ddclId], references: [id])
  stepId          String?
  step            Step?        @relation(fields: [stepId], references: [id], onDelete: Restrict)
  order           Int          @default(1)
  parameterValues Json?
  stepSnapshot    Json

  @@index([stepId])
}
