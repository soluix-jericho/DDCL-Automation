{
  "name": "ddcl-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend Portal DDCL Otomatis (Fastify + Prisma + ExcelJS)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:prod": "./scripts/start-prod.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:load": "vitest run -c vitest.load.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cookie": "9.4.0",
    "@fastify/cors": "9.0.1",
    "@prisma/client": "5.22.0",
    "exceljs": "4.4.0",
    "fastify": "4.28.1"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/node": "20.17.6",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.15.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.3",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
