# Copy to .env and change the values. .env is gitignored; never commit real credentials.

# --- PostgreSQL (used only when the volume is first initialised; changing them later does not
#     change credentials in an existing volume. Reset with `docker compose down -v`, which DELETES data.)
POSTGRES_USER=ddcl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ddcl

# Backend connection string (host `db` = the Compose service). URL-encode special characters in the password.
# connection_limit=10: size of the Prisma connection pool (4 concurrent Library writes plus reads).
DATABASE_URL=postgresql://ddcl:change-me@db:5432/ddcl?connection_limit=10
# Disposable database used by the automated tests (its name MUST contain "test"; it is created by the test setup).
TEST_DATABASE_URL=postgresql://ddcl:change-me@db:5432/ddcl_test

# --- Backend
BACKEND_PORT=3000
# Optional: how many pre-migration database dumps to keep in the ddcl_backups volume (default 10).
# BACKUP_KEEP=10
# Browser origins allowed by CORS (with credentials, so the session cookie is sent) and by the Origin check on
# write requests. Comma separated. The backend refuses to start when this is empty.
# (FRONTEND_ORIGIN, the older single-origin name, is only read when this is empty.)
ALLOWED_ORIGINS=http://localhost:5173

# --- First admin (used only while there are no accounts; ignored afterwards).
# The backend refuses to start with no account and no valid ADMIN_*. The password below is a placeholder that
# the backend rejects on purpose: set your own (10-128 characters) before the first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-10-chars
ADMIN_NAME=Administrator

# --- Session cookie
# Keep false for local Docker Compose over http. Set true when the portal is served over HTTPS.
# Outside local use, serve frontend and backend from one site (same registrable domain) over HTTPS:
# the cookie is SameSite=Lax, so a frontend on another site would not send it.
COOKIE_SECURE=false
# true only behind a reverse proxy you control: then X-Forwarded-For is trusted for the address in logs and audit.
TRUST_PROXY=false
# Path INSIDE the backend container. Put the template file in ./template/ on the host first.
# Quoted because the file name contains spaces.
DDCL_TEMPLATE_PATH="/app/template/DDCL BCAS PROD 202611 - TEMPLATE.xlsx"

# --- Frontend
FRONTEND_PORT=5173
# Backend address as seen from the browser.
VITE_API_BASE_URL=http://localhost:3000
