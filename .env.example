# Copy to .env and change the values. .env is gitignored; never commit real credentials.

# --- PostgreSQL (used only when the volume is first initialised; changing them later does not
#     change credentials in an existing volume. Reset with `docker compose down -v`, which DELETES data.)
POSTGRES_USER=ddcl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ddcl

# Backend connection string (host `db` = the Compose service). URL-encode special characters in the password.
DATABASE_URL=postgresql://ddcl:change-me@db:5432/ddcl
# Disposable database used by the automated tests (its name MUST contain "test"; it is created by the test setup).
TEST_DATABASE_URL=postgresql://ddcl:change-me@db:5432/ddcl_test

# --- Backend
BACKEND_PORT=3000
# Only this origin is allowed by CORS (with credentials, so the session cookie is sent).
FRONTEND_ORIGIN=http://localhost:5173
# Path INSIDE the backend container. Put the template file in ./template/ on the host first.
# Quoted because the file name contains spaces.
DDCL_TEMPLATE_PATH="/app/template/DDCL BCAS PROD 202611 - TEMPLATE.xlsx"

# --- Frontend
FRONTEND_PORT=5173
# Backend address as seen from the browser.
VITE_API_BASE_URL=http://localhost:3000
